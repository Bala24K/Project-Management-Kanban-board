# apps/api reads these (copy to apps/api/.env for local development)
DATABASE_URL="postgresql://kanban:kanban@localhost:5434/kanban?schema=public"
PORT=4000
# Comma-separated list of allowed browser origins for the API in development.
# In production the API serves the built frontend from the same origin, so this can stay empty.
CORS_ORIGINS="http://localhost:5173"
# When "true", requests carrying the X-Simulate-Failure header fail with HTTP 503 before touching the DB.
# Defaults to true outside production, false in production.
FAILURE_SIMULATION="true"
# Optional: random failure rate (0..1) applied to write requests when FAILURE_SIMULATION is on. Default 0.
FAILURE_RATE="0"
